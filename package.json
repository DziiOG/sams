{
  "name": "sams",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint --max-warnings 0 --ext .ts .",
    "lint:fix": "eslint --fix --ext .ts .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "jest --config jest.unit.config.cjs --runInBand",
    "test:integration": "DOCKER_HOST=${DOCKER_HOST:-unix:///var/run/docker.sock} TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=${TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE:-/var/run/docker.sock} jest --config jest.integration.config.cjs --runInBand",
    "start:gateway": "pnpm --filter @sams/gateway-service start",
    "start:orchestrator": "pnpm --filter @sams/orchestrator-service start",
    "start:sender": "pnpm --filter @sams/sender-service start"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "testcontainers": "^10.24.1",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}